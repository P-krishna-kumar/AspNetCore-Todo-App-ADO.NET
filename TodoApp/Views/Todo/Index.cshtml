@{
}
@model List<TodoApp.Models.Todo>

@{
    ViewData["Title"] = "Todo List";
}

<h1>Todo List</h1>

<form asp-action="Add" method="post">
    <input type="text" name="task" placeholder="Add new task" required />
    <button type="submit">Add</button>
</form>

<table>
    <thead>
        <tr>
            <th>Task</th>
            <th>Completed</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Task</td>
                <td>
                    <form asp-action="UpdateStatus" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="checkbox" name="isCompleted" onchange="this.form.submit()" @(item.IsCompleted ? "checked" : "") />
                    </form>
                </td>
                <td>
                    <form asp-action="Delete" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
